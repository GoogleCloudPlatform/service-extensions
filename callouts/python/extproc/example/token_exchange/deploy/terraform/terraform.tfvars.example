# Copy this file to terraform.tfvars and fill in your values.

project_id = "your-gcp-project-id"
region     = "us-central1"

# Container image. Build and push using cloudbuild.yaml.
callout_image = "us-central1-docker.pkg.dev/your-project/token-exchange/callout:latest"

# callout_service_account = "token-exchange-sa@your-project.iam.gserviceaccount.com"

# --- INBOUND example: external partners (Azure AD) calling Vertex AI ---
mode         = "INBOUND"
wif_audience = "//iam.googleapis.com/projects/123456789012/locations/global/workloadIdentityPools/azure-ad-pool/providers/azure-ad-provider"
# target_service_account = "vertex-ai-invoker@your-project.iam.gserviceaccount.com"

# --- OUTBOUND example: internal agents calling Salesforce ---
# mode                    = "OUTBOUND"
# outbound_target_host    = "mycompany.my.salesforce.com"
# external_token_endpoint = "https://mycompany.my.salesforce.com/services/oauth2/token"
# external_client_id      = "3MVG9...salesforce-connected-app-id"
