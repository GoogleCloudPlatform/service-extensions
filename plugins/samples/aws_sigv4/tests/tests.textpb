# Test suite: SigV4 (regional) — S3 us-east-1.
# Config: config_sigv4.json  |  Frozen time: 2024-01-01T00:00:00Z.
env {
  time_secs: 1704067200
}

# GET request: correct credential scope, date header, and empty-body hash.
test {
  name: "SigV4_S3_GET"
  request_headers {
    input {
      header { key: ":method"    value: "GET" }
      header { key: ":path"      value: "/my-bucket/my-key" }
      header { key: ":authority" value: "s3.amazonaws.com" }
    }
    result {
      # Authorization must start with the SigV4 algorithm and contain the
      # correct credential scope (date/region/service).
      headers {
        regex: "Authorization: AWS4-HMAC-SHA256 Credential=AKIAIOSFODNN7EXAMPLE/20240101/us-east-1/s3/aws4_request,SignedHeaders=host;x-amz-date,Signature=[a-f0-9]{64}"
      }
      # Frozen time must appear in x-amz-date.
      has_header { key: "x-amz-date" value: "20240101T000000Z" }
      # GET has no body → payload hash is the SHA256 of the empty string.
      has_header {
        key: "x-amz-content-sha256"
        value: "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
      }
    }
  }
}

# GET with query string: the canonical query must be sorted lexicographically.
test {
  name: "SigV4_S3_GET_WithQueryString"
  request_headers {
    input {
      header { key: ":method"    value: "GET" }
      header { key: ":path"      value: "/my-bucket/my-key?Version=2010-05-08&Action=ListUsers" }
      header { key: ":authority" value: "s3.amazonaws.com" }
    }
    result {
      headers { regex: "Authorization: AWS4-HMAC-SHA256 Credential=AKIAIOSFODNN7EXAMPLE/20240101/us-east-1/s3/aws4_request,.*" }
    }
  }
}

# Internal whitespace in header values must be collapsed to a single space.
test {
  name: "SigV4_S3_GET_HeaderWhitespaceCollapse"
  request_headers {
    input {
      header { key: ":method"        value: "GET" }
      header { key: ":path"          value: "/" }
      header { key: ":authority"     value: "s3.amazonaws.com" }
      header { key: "x-amz-meta-tag" value: "  first   value  " }
    }
    result {
      # Presence of Authorization confirms the signing pipeline ran.
      # The correct canonical form of the header value is verified by unit tests.
      headers { regex: "Authorization: AWS4-HMAC-SHA256 .*" }
      # x-amz-meta-tag must appear in SignedHeaders.
      headers { regex: "Authorization: .*SignedHeaders=host;x-amz-date;x-amz-meta-tag,.*" }
    }
  }
}

# Duplicate headers must be joined with comma in the canonical block.
test {
  name: "SigV4_S3_GET_DuplicateHeaders"
  request_headers {
    input {
      header { key: ":method"        value: "GET" }
      header { key: ":path"          value: "/" }
      header { key: ":authority"     value: "s3.amazonaws.com" }
      header { key: "x-amz-meta-tag" value: "first" }
      header { key: "x-amz-meta-tag" value: "second" }
    }
    result {
      headers { regex: "Authorization: AWS4-HMAC-SHA256 .*" }
      # x-amz-meta-tag appears only once in SignedHeaders despite two values.
      headers { regex: "Authorization: .*SignedHeaders=host;x-amz-date;x-amz-meta-tag,.*" }
    }
  }
}
