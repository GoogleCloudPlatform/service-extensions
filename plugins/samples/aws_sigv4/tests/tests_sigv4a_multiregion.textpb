# Test suite: SigV4a — S3 MRAP, multi-region "us-east-1,us-west-2".
# Config: config_sigv4a_multiregion.json  |  Frozen time: 2024-01-01T00:00:00Z.
env {
  time_secs: 1704067200
}

# V4a with explicit region-set: credential scope must contain only service (no region).
test {
  name: "SigV4a_S3_GET_MultiRegionSet"
  request_headers {
    input {
      header { key: ":method"    value: "GET" }
      header { key: ":path"      value: "/" }
      header { key: ":authority" value: "s3.amazonaws.com" }
    }
    result {
      headers { regex: "Authorization: AWS4-ECDSA-P256-SHA256 Credential=AKIAIOSFODNN7EXAMPLE/20240101/s3/aws4_request,.*" }
      # Neither region name may appear in the credential scope.
      headers { regex: "Authorization: .*us-east-1.*" invert: true }
      headers { regex: "Authorization: .*us-west-2.*" invert: true }
      # x-amz-region-set must carry the comma-separated region list.
      has_header { key: "x-amz-region-set" value: "us-east-1,us-west-2" }
    }
  }
}
