# Test suite: fail-open — no config file supplied.
# When access_key or secret_key is empty the credential guard in
# finalize_and_sign skips signing and must NOT inject an Authorization header.
env {
  time_secs: 1704067200
}

# No config → empty credentials → guard triggers → no Authorization.
test {
  name: "FailOpen_NoConfig_NoAuthorization"
  request_headers {
    input {
      header { key: ":method"    value: "GET" }
      header { key: ":path"      value: "/" }
      header { key: ":authority" value: "example.com" }
    }
    result {
      no_header { key: "Authorization" }
      # x-amz-date is still injected (set before the credential guard runs).
      has_header { key: "x-amz-date" value: "20240101T000000Z" }
    }
  }
}
