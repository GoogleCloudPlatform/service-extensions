# Test suite: SigV4a — S3 MRAP, global region-set "*".
# Config: config_sigv4a_global.json  |  Frozen time: 2024-01-01T00:00:00Z.
env {
  time_secs: 1704067200
}

# V4a GET: uses ECDSA-P256; credential scope omits region; x-amz-region-set injected.
test {
  name: "SigV4a_S3_GET_GlobalRegionSet"
  request_headers {
    input {
      header { key: ":method"    value: "GET" }
      header { key: ":path"      value: "/my-bucket/my-key" }
      header { key: ":authority" value: "s3.amazonaws.com" }
    }
    result {
      # Algorithm must be ECDSA-P256-SHA256, not HMAC-SHA256.
      headers { regex: "Authorization: AWS4-ECDSA-P256-SHA256 Credential=AKIAIOSFODNN7EXAMPLE/20240101/s3/aws4_request,.*" }
      # Region must NOT appear in the credential scope.
      headers { regex: "Authorization: .*[0-9]{8}/[^/]+/[^/]+/s3/.*" invert: true }
      # x-amz-region-set must be injected with the configured region-set value.
      has_header { key: "x-amz-region-set" value: "*" }
    }
  }
}
