# Test suite: SigV4 (regional) — EC2 POST with body.
# Config: config_sigv4_ec2.json  |  Frozen time: 2024-01-01T00:00:00Z.
env {
  time_secs: 1704067200
}

# POST with body: signing is now resolved in the headers phase to prevent buffering deadlocks.
# Non-S3 services fallback to signing with the empty string hash.
test {
  name: "SigV4_EC2_POST_WithBody"
  request_headers {
    input {
      header { key: ":method"        value: "POST" }
      header { key: ":path"          value: "/" }
      header { key: ":authority"     value: "ec2.amazonaws.com" }
      header { key: "content-type"   value: "application/x-www-form-urlencoded" }
      header { key: "content-length" value: "43" }
    }
    result {
      has_header { key: "x-amz-date" value: "20240101T000000Z" }
      headers { regex: "Authorization: AWS4-HMAC-SHA256 Credential=AKIAIOSFODNN7EXAMPLE/20240101/us-east-1/ec2/aws4_request,.*" }
      has_header {
        key: "x-amz-content-sha256"
        value: "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
      }
    }
  }
  request_body {
    input { content: "Action=DescribeInstances&Version=2016-11-15" }
  }
}
